eaders(); self.wfile.write(body)\n    def log_message(self, *_args): return\nThreadingHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\n"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-29T22:25:03Z", "name": "uploads-api-source", "namespace": "proofix-case-14"}}], "kind": "List", "metadata": {}}, "source": "kubectl/get/configmaps#74dd776bd2ca"}, "previous_hash": "8754c4350b5cb25ee96cca9ba07957f11e0b6d103b80ea22cf6670f82873d694", "run_id": "case-14-react-t3-20260829T222407Z", "schema_version": "1.0", "sequence": 9, "sources": ["kubectl/get/configmaps#74dd776bd2ca"], "stage": "react", "timestamp": "2026-08-29T22:25:15.030813+00:00"}
