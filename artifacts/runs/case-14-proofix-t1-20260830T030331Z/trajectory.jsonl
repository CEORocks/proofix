eaders(); self.wfile.write(body)\n    def log_message(self, *_args): return\nThreadingHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\n"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-30T03:03:34Z", "name": "uploads-api-source", "namespace": "proofix-case-14"}}], "kind": "List", "metadata": {}}, "source": "kubectl/get/configmaps#1cab19211508"}, "previous_hash": "5933515430392a0e120241859194c7acc7f1aeeb68cd98bc89330bc9b698e465", "run_id": "case-14-proofix-t1-20260830T030331Z", "schema_version": "1.0", "sequence": 10, "sources": ["kubectl/get/configmaps#1cab19211508"], "stage": "observe", "timestamp": "2026-08-30T03:04:09.280284+00:00"}
