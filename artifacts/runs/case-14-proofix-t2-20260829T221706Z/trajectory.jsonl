eaders(); self.wfile.write(body)\n    def log_message(self, *_args): return\nThreadingHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\n"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-29T22:18:04Z", "name": "uploads-api-source", "namespace": "proofix-case-14"}}], "kind": "List", "metadata": {}}, "source": "kubectl/get/configmaps#f0e9291c198a"}, "previous_hash": "0c3c2bb825d5d5a7d820c12ebd81664d6c2ebeb95ff358a8901dc7066361857c", "run_id": "case-14-proofix-t2-20260829T221706Z", "schema_version": "1.0", "sequence": 10, "sources": ["kubectl/get/configmaps#f0e9291c198a"], "stage": "observe", "timestamp": "2026-08-29T22:18:22.441425+00:00"}
