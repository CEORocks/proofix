eaders(); self.wfile.write(body)\n    def log_message(self, *_args): return\nThreadingHTTPServer((\"0.0.0.0\", 8080), Handler).serve_forever()\n"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-29T22:21:24Z", "name": "uploads-api-source", "namespace": "proofix-case-14"}}], "kind": "List", "metadata": {}}, "source": "kubectl/get/configmaps#e1d04f405fa3"}, "previous_hash": "5aef771f393ef2d983d5087943ac480ebae81df53aa0aaf1a10bfe58b7499236", "run_id": "case-14-react-t2-20260829T222025Z", "schema_version": "1.0", "sequence": 9, "sources": ["kubectl/get/configmaps#e1d04f405fa3"], "stage": "react", "timestamp": "2026-08-29T22:21:36.888430+00:00"}
