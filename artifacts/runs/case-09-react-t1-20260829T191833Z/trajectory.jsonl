{"event_hash": "c7d234dfe28a54715a7d9a5275768582eda8801f8f2b4b3cae7645cfb32aa4f4", "event_type": "observation_collected", "payload": {"collected_at": null, "data": {"apiVersion": "v1", "items": [{"apiVersion": "v1", "data": {"InventoryServer.java": "import com.sun.net.httpserver.HttpExchange;\nimport com.sun.net.httpserver.HttpServer;\nimport java.io.IOException;\nimport java.io.InputStream;\nimport java.net.InetSocketAddress;\nimport java.net.URI;\nimport java.net.http.HttpClient;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.nio.charset.StandardCharsets;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.security.KeyStore;\nimport java.security.cert.Certificate;\nimport java.security.cert.CertificateFactory;\nimport java.time.Duration;\nimport java.util.concurrent.Executors;\nimport javax.net.ssl.SSLContext;\nimport javax.net.ssl.TrustManagerFactory;\n\npublic final class InventoryServer {\n    private static final Path TOKEN = Path.of(\n            \"/var/run/secrets/kubernetes.io/serviceaccount/token\");\n    private static final Path CA = Path.of(\n            \"/var/run/secrets/kubernetes.io/serviceaccount/ca.crt\");\n    private static HttpClient client;\n    private static URI settingsUri;\n\n    private InventoryServer() {}\n\n    private static SSLContext serviceAccountTls() throws Exception {\n        CertificateFactory factory = CertificateFactory.getInstance(\"X.509\");\n        Certificate certificate;\n        try (InputStream input = Files.newInputStream(CA)) {\n            certificate = factory.generateCertificate(input);\n        }\n        KeyStore store = KeyStore.getInstance(KeyStore.getDefaultType());\n        store.load(null);\n        store.setCertificateEntry(\"kubernetes-service-account-ca\", certificate);\n        TrustManagerFactory managers = TrustManagerFactory.getInstance(\n                TrustManagerFactory.getDefaultAlgorithm());\n        managers.init(store);\n        SSLContext context = SSLContext.getInstance(\"TLS\");\n        context.init(null, managers.getTrustManagers(), null);\n        return context;\n    }\n\n    private static void reply(HttpExchange exchange, int status, String body)\n            throws IOException {\n        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);\n        exchange.getResponseHeaders().set(\"Content-Type\", \"application/json\");\n        exchange.getResponseHeaders().set(\"Cache-Control\", \"no-store\");\n        exchange.sendResponseHeaders(status, bytes.length);\n        exchange.getResponseBody().write(bytes);\n        exchange.close();\n    }\n\n    private static void inventory(HttpExchange exchange) throws IOException {\n        try {\n            String token = Files.readString(TOKEN, StandardCharsets.UTF_8).trim();\n            HttpRequest request = HttpRequest.newBuilder(settingsUri)\n                    .timeout(Duration.ofSeconds(2))\n                    .header(\"Authorization\", \"Bearer \" + token)\n                    .header(\"Accept\", \"application/json\")\n                    .GET().build();\n            HttpResponse<Void> response = client.send(\n                    request, HttpResponse.BodyHandlers.discarding());\n            if (response.statusCode() == 200) {\n                reply(exchange, 200, \"{\\\"ok\\\":true,\\\"reconciled\\\":true}\\n\");\n            } else {\n                reply(exchange, 503, \"{\\\"ok\\\":false,\\\"kubernetes_status\\\":\"\n                        + response.statusCode() + \"}\\n\");\n            }\n        } catch (InterruptedException interrupted) {\n            Thread.currentThread().interrupt();\n            reply(exchange, 503, \"{\\\"ok\\\":false,\\\"error\\\":\\\"interrupted\\\"}\\n\");\n        } catch (Exception error) {\n            reply(exchange, 503, \"{\\\"ok\\\":false,\\\"error\\\":\\\"api_request_failed\\\"}\\n\");\n        }\n    }\n\n    public static void main(String[] args) throws Exception {\n        String host = System.getenv(\"KUBERNETES_SERVICE_HOST\");\n        String port = System.getenv().getOrDefault(\"KUBERNETES_SERVICE_PORT_HTTPS\", \"443\");\n        settingsUri = URI.create(\"https://\" + host + \":\" + port\n                + \"/api/v1/namespaces/proofix-case-09/configmaps/inventory-settings\");\n        client = HttpClient.newBuilder().sslContext(serviceAccountTls())\n                .connectTimeout(Duration.ofSeconds(2)).build();\n        HttpServer server = HttpServer.create(new InetSocketAddress(8080), 0);\n        server.createContext(\"/healthz\", exchange ->\n                reply(exchange, 200, \"{\\\"ok\\\":true}\\n\"));\n        server.createContext(\"/inventory\", InventoryServer::inventory);\n        server.setExecutor(Executors.newFixedThreadPool(8));\n        server.start();\n        System.out.println(\"inventory-controller listening on :8080\");\n    }\n}\n"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-29T00:55:28Z", "name": "inventory-controller-source", "namespace": "proofix-case-09"}}, {"apiVersion": "v1", "data": {"reconciliation_interval_seconds": "30", "warehouse": "eu-central"}, "kind": "ConfigMap", "metadata": {"annotations": {}, "creationTimestamp": "2026-08-29T00:55:28Z", "labels": {"proofix.io/case": "CASE-09"}, "name": "inventory-settings", "namespace": "proofix-case-09"}}, {"apiVersion": "v1", "data": {"ca-crl.pem": ""}, "kind": "ConfigMap", "metadata": {"creationTimestamp": "2026-08-29T00:55:27Z", "labels": {"istio.io/config": "true"}, "name": "istio-ca-crl", "namespace": "proofix-case-09"}}, {"apiVersion": "v1", "data": {"root-cert.pem": "-----BEGIN CERTIFICATE-----\nMIIC/DCCAeSgAwIBAgIQYghIc8CR+NC78QQfxHNhYjANBgkqhkiG9w0BAQsFADAY\nMRYwFAYDVQQKEw1jbHVzdGVyLmxvY2FsMB4XDTI2MDgyODIyNDYyOVoXDTM2MDgy\nNTIyNDYyOVowGDEWMBQGA1UEChMNY2x1c3Rlci5sb2NhbDCCASIwDQYJKoZIhvcN\nAQEBBQADggEPADCCAQoCggEBAN4Kd52GdQORqJC5EfTC5fBJCGVRVXqPDHSCGySL\nmVq6g6q3c5tM1ZSAtwCWlJBbR0atuwyWzhtvzK2zv8Xiw6hFaN5IvvI6P8CYeGwC\nPNjqaA