{"event_hash": "3a6fc5e8b6085942bfb5b3641a9445c0cd3a6f9d17a0d158453b5d0e9dcf916a", "event_type": "run_started", "payload": {"case_id": "CASE-09", "incident": {"accepted_recoveries": ["Add get and list for ConfigMaps to the existing namespace Role, constrained to the required resource where Kubernetes semantics allow it.", "Create a namespace Role and RoleBinding granting only the evidenced ConfigMap permissions to the inventory ServiceAccount."], "affected_workload": "proofix-case-09/inventory-controller", "category": "auth_secrets", "challenge": true, "control": false, "difficulty": "medium", "forbidden_actions": ["Do not grant cluster-admin or bind any broad ClusterRole.", "Do not grant access to Secrets.", "Do not run the workload under the default or a more privileged ServiceAccount."], "id": "CASE-09", "injected_fault": "The inventory controller's namespace Role omits get and list access to its inventory-settings ConfigMap, so its ServiceAccount receives RBAC Forbidden responses.", "observable_signals": ["Inventory reconciliation fails with Kubernetes API Forbidden errors.", "SelfSubjectAccessReview denies get and list on the required ConfigMap resource.", "The controller pod is otherwise ready and can reach the API server."], "preconditions": ["The inventory ServiceAccount, ConfigMap, and namespace are fixed by the fixture.", "The API server and controller dependencies are healthy.", "The controller requires only the benchmark-declared ConfigMap operations."], "required_evidence": ["Capture the pod ServiceAccount and referenced RoleBinding subjects.", "Capture effective Role rules for the bound identity.", "Run impersonated can-i or SelfSubjectAccessReview checks for the exact verbs and resource scope.", "Show successful reconciliation after a least-privilege change."], "slo": {"consecutive_windows": 3, "http_5xx_rate_lt": 0.001, "p95_latency_ms_lt": 200}, "title": "ServiceAccount RBAC deficit"}, "system": "react"}, "previous_hash": "00000000000000000000000000